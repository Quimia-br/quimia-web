  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
